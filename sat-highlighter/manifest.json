{
  "manifest_version": 3,
  "name": "Headline Highlighter for Canva",
  "version": "4.0.2",
  "description": "Created by Oeng Kimchour. Finds the headline, caption and hashtags in any post, colours Canva headlines and fills Notes.",
  "permissions": [
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.canva.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.canva.com/design/*"
      ],
      "js": [
        "engine.js",
        "intent.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "engine.js",
        "chat.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Headline Highlighter"
  },
  "background": {
    "service_worker": "background.js"
  },
  "author": "Oeng Kimchour",
  "homepage_url": "https://github.com/Kimchour/Canva-Headline-Highlighter"
}
